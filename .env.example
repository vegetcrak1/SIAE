# Copie este archivo a .env (o ejecute `npm run init`, que lo crea con un secreto aleatorio).

# OBLIGATORIO. Mínimo 32 caracteres aleatorios. Firma los códigos QR y los tokens de registro.
# Si lo cambia, los QR vigentes dejan de ser válidos (se regeneran solos en la app del estudiante).
APP_SECRET=

# Opcional. Client ID de Google (tipo "Aplicación web"). Vacío = el botón de Google no aparece. Google exige https.
# https://console.cloud.google.com/apis/credentials  → Orígenes autorizados de JavaScript: la URL pública de la app.
GOOGLE_CLIENT_ID=

# Opcional: correos de Google que serán administradores automáticamente (separados por comas).
# Normalmente no hace falta: el primer administrador se crea con `npm run create-admin`.
ADMIN_EMAILS=

# Nombre de la institución (se muestra en el inicio de sesión).
INSTITUTION_NAME=

NODE_ENV=production

# 0 = la app se abre con http:// (red local del colegio). 1 = se abre con https:// (recomendado si hay dominio).
# Con 1, las cookies se marcan Secure y se activa HSTS: NO funciona si abre la app por http://.
COOKIE_SECURE=0

# 1 solo si hay un proxy/túnel delante (Caddy, Nginx, Cloudflare Tunnel…) para leer la IP real del visitante.
TRUST_PROXY=0

# Intentos de ingreso por IP cada 10 minutos (los colegios comparten IP pública; el bloqueo por cuenta es la defensa principal).
LOGIN_RATE_LIMIT=100

# --- Solo para Vercel (o cualquier hosting sin disco): base de datos remota Turso. ---
# Déjelos VACÍOS en el servidor del colegio (allí se usa el archivo local DB_PATH).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

PORT=3000
HOST=0.0.0.0
DB_PATH=./data/siae.db
SCHOOL_TZ=America/Bogota
